{
  "name": "eth_blockNumber via PATH Gateway",
  "description": "Request the current Ethereum block number through Pocket Network PATH gateway",
  "request": {
    "method": "POST",
    "url": "https://eth.rpc.grove.city/v1",
    "headers": {
      "Content-Type": "application/json",
      "Portal-Application-ID": "YOUR_APP_ID"
    },
    "body": {
      "jsonrpc": "2.0",
      "method": "eth_blockNumber",
      "params": [],
      "id": 1
    }
  },
  "response": {
    "status": 200,
    "body": {
      "jsonrpc": "2.0",
      "id": 1,
      "result": "0x12d687c"
    }
  }
}